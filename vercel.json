{
  "version": 2,
  "buildCommand": "npm --prefix StudyTrack/frontend install && npm --prefix StudyTrack/frontend run build",
  "outputDirectory": "StudyTrack/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
